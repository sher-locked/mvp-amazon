# server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# shared key required (x-access-key header or ?key=) on all API routes;
# leave unset to disable the guard entirely (local dev)
ACCESS_KEY=
# base directory for the versioned artifact store; defaults to <cwd>/tmp.
# on Railway set this to the volume mount path, e.g. /data
ARTIFACTS_DIR=

# provider selection
DEFAULT_SCRAPER=brightdata-unlocker   # playwright | brightdata-unlocker | brightdata-browser
DEFAULT_LLM=anthropic                 # anthropic | openai | perplexity

# brightdata
BRIGHTDATA_UNLOCKER_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
# websocket endpoint for the browser api, e.g. wss://brd-customer-...:port
BRIGHTDATA_BROWSER_WSE=

# llm keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# faster/cheaper model for generation calls; falls back to OPENAI_MODEL when unset
OPENAI_MODEL_FAST=
PERPLEXITY_API_KEY=
