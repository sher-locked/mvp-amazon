# server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# provider selection
DEFAULT_SCRAPER=brightdata-unlocker   # playwright | brightdata-unlocker | brightdata-browser
DEFAULT_LLM=anthropic                 # anthropic | openai | perplexity

# brightdata
BRIGHTDATA_UNLOCKER_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
# websocket endpoint for the browser api, e.g. wss://brd-customer-...:port
BRIGHTDATA_BROWSER_WSE=

# llm keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
PERPLEXITY_API_KEY=
